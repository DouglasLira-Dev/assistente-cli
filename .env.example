# ============================================
# Chaves de API (preencher no .env real, NUNCA commitar)
# ============================================
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ============================================
# Diretórios de dados (valores padrão usados pelo config.go)
# ============================================
DATA_DIR=./data
ARTICLES_DIR=./data/articles
TEMPLATES_DIR=./data/templates

# ============================================
# Modelos sugeridos (ajustar conforme disponibilidade no free tier)
# ============================================
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free